---
import Layout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';

const tradeHero = {
  companyName: 'Handel & Gastronomie',
  heroTitle: 'Italienische Spezialitäten für anspruchsvolle Sortimente.',
  heroText:
    'SOTTO IL SOLE importiert ausgewählte Produkte kleiner italienischer Produzenten für Feinkosthandel, Gastronomie und besondere Genussmomente.',
};
---

<Layout title="Handel | SOTTO IL SOLE">
  <Header />

 <main>
<Hero siteSettings={tradeHero} showButton={false} showBackgroundImage={false} />

  <section class="section brands">
    <div class="container">
      <p class="section__eyebrow">Unsere Überzeugung</p>
      <h2 class="section__title">Handel beginnt mit Vertrauen.</h2>
      <p class="section__intro">
        Wir arbeiten mit ausgewählten italienischen Herstellern zusammen, die wir persönlich
        kennen: kleine Familienbetriebe mit eigener Geschichte, regionaler Verwurzelung
        und einem klaren Anspruch an Qualität.
      </p>
    </div>
  </section>

  <ContactSection variant="trade" />
</main>

<style>
  
  .brands {
    background: var(--color-green-dark);
    color: var(--color-sand);
  }

  .brands .section__eyebrow {
    color: rgba(222, 218, 213, 0.9);
  }
}
</style>
